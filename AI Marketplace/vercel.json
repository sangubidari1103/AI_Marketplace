{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "backend/src/index.js": {
      "maxDuration": 30
    }
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}